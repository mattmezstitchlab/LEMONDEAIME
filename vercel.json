{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/analyse.mjs": {
      "maxDuration": 30
    },
    "api/orbe.mjs": {
      "maxDuration": 20
    },
    "api/maintenance.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/atlas/:chemin*",
      "destination": "https://atlas.lemondeaime.com/:chemin*"
    },
    {
      "source": "/studio/:chemin*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/api/auth/:chemin*",
      "destination": "/api/comptes?__chemin=:chemin*"
    },
    {
      "source": "/lien/:chemin*",
      "destination": "/api/comptes?__lien=:chemin*"
    },
    {
      "source": "/:fiche(projets|reseau)/:cle",
      "destination": "/index.html"
    },
    {
      "source": "/:page(projets|aime-wedding|admin|a-propos|point-zero|buro|reseau|entrer|a-plus|boutique|musique|charte|monde)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/studio/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/studio/"
        }
      ]
    }
  ],
  "installCommand": "npm ci && npm ci --prefix studio",
  "redirects": [
    {
      "source": "/atlas",
      "destination": "/atlas/",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/studio/",
      "permanent": false
    },
    {
      "source": "/bureau",
      "destination": "/studio/bureau",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "17 3 * * *"
    }
  ]
}
