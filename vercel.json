{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/analyse.mjs": {
      "maxDuration": 30
    },
    "api/orbe.mjs": {
      "maxDuration": 20
    },
    "api/systeme.mjs": {
      "includeFiles": "cartographie/*.json"
    },
    "api/maintenance.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/studio/:chemin*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/api/auth/:chemin*",
      "destination": "/api/comptes?__chemin=:chemin*"
    },
    {
      "source": "/lien/:chemin*",
      "destination": "/api/comptes?__lien=:chemin*"
    },
    {
      "source": "/((?!api/|media/|assets/|studio/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/studio/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/studio/"
        }
      ]
    }
  ],
  "installCommand": "npm ci && npm ci --prefix studio",
  "redirects": [
    {
      "source": "/studio",
      "destination": "/studio/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "17 3 * * *"
    }
  ]
}
