{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/analyse.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:chemin*",
      "destination": "/api/comptes?__chemin=:chemin*"
    },
    {
      "source": "/((?!api/|media/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
